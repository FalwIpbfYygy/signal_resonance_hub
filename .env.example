# ============================================================================
# TRAE 项目环境变量模板
# 用法：复制本文件为 .env 并填入你自己的值（.env 已被 .gitignore 忽略，不会提交）。
# 所有密钥 / Webhook / 代理 / 价格接口均从此文件（或系统环境变量）读取，源码不含明文。
# 留空的项：推送类会在未配置时跳过；代理类留空 = 零代理直连。
# ============================================================================

# ---------- 飞书机器人 Webhook（每个子系统对应一个变量）----------
# 注意：多个子系统共用 FEISHU_WEBHOOK 这一个变量；共振/日报系统各有独立变量。
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/你的webhook地址
RESONANCE_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/你的webhook地址
REPORT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/你的webhook地址

# ---------- TRAE -> Agent 转发层共享 secret（与 TRADING_AGENT 侧保持一致）----------
AGENT_SECRET=你的共享secret
AGENT_BASE_URL=http://127.0.0.1:8000

# ---------- QQ 邮箱推送（可选，不用的话留空）----------
QQ_EMAIL_SENDER=你的qq@qq.com
QQ_EMAIL_RECEIVER=你的qq@qq.com
QQ_EMAIL_AUTH_CODE=你的QQ_SMTP授权码

# ---------- 本地开发代理（直连服务器请留空 = 零代理）----------
BACKTEST_PROXY=
HAMMER_PROXY=

# ---------- 价格接口（公开端点，默认值即可，可按需覆盖）----------
# 部署时通过 .env 注入真实交易所期货 K 线接口（勿在仓库提交真实地址）
BINANCE_FUTURES_KLINE_URL=
# 部署时通过 .env 注入真实交易所现货 K 线接口
BINANCE_SPOT_KLINE_URL=

# ---------- TRADING_AGENT / 阿里云百炼 LLM ----------
LLM_API_KEY=你的百炼APIKey
LLM_WORKSPACE_ID=你的workspace_id
LLM_BASE_URL=https://你的workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
